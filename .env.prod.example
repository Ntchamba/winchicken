# .env for docker-compose.prod.yml — the installer writes the real one ONCE, with random values,
# and never overwrites it (a new DB_PASSWORD would lock the app out of its existing database).
# To set it up by hand: copy to .env and replace every "changez-moi".

SECRET_KEY=changez-moi-50-caracteres-aleatoires
DB_PASSWORD=changez-moi

# Port on the PC. Phones on the farm Wi-Fi open http://<adresse-ip-du-pc>:8080
WINCHICKEN_PORT=8080
TZ=Africa/Douala

# Images: built locally by default; the installer points these at the published images.
WINCHICKEN_IMAGE_PREFIX=winchicken
WINCHICKEN_VERSION=local

# SMS: "console" sends nothing (logs only) until a provider is configured.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=WINCHICKEN

# Web Push (desktop notifications). Generate once:
#   docker compose -f docker-compose.prod.yml exec web python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@winchicken.local

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
