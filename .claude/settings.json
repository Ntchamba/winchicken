{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-verify.sh\"",
            "timeout": 180,
            "statusMessage": "post-edit-verify: build + lint + related test"
          }
        ]
      }
    ]
  }
}
