# Generate a real value before starting the app, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=winchicken
DB_USER=winchicken
DB_PASSWORD=winchicken
# 5433, not 5432: avoids clashing with a system-installed Postgres that may already
# own 5432 on the host. Only applies when running manage.py directly against the
# dockerized db service from outside its container network — inside docker-compose,
# web/worker reach it at db:5432 regardless of this host-side mapping.
DB_HOST=localhost
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:5173

REDIS_URL=redis://localhost:6379/0

# SMS gateway — "console" logs messages instead of sending, for local dev
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=WINCHICKEN
