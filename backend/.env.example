SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=winchicken
DB_USER=winchicken
DB_PASSWORD=winchicken
# 5433, not 5432: avoids clashing with a system-installed Postgres that may already
# own 5432 on the host. Only applies when running manage.py directly against the
# dockerized db service from outside its container network — inside docker-compose,
# web/worker reach it at db:5432 regardless of this host-side mapping.
DB_HOST=localhost
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:5173

REDIS_URL=redis://localhost:6379/0

# SMS gateway — "console" logs messages instead of sending, for local dev
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=WINCHICKEN

# Automated backups (docker-compose.yml `backup` service, apps.core.management.commands.
# backup_db) — how many seconds between dumps (86400 = nightly) and how many to keep before
# pruning older ones. See README "Backups" section.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7

# Web Push / desktop notifications (apps.alerts.push). Generate a keypair once:
#   docker compose exec web python manage.py generate_vapid_keys
# then paste both values here. Push is disabled while either is blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@winchicken.local
