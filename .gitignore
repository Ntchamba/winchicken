# Python
__pycache__/
*.pyc
backend/.venv/
backend/venv/
*.egg-info/

# Django
backend/staticfiles/
backend/media/
backend/.pytest_cache/

# Factory-reset audit trail (backend/config/settings.py LOGGING) — server-local, not source
backend/logs/*.log

# Database backups (backend/apps/core/management/commands/backup_db.py) — server-local, not source
backend/backups/*.dump

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env files (real secrets/local overrides — .env.example stays tracked)
# Root .env holds the docker-compose overrides (TZ, BACKUP_*, TWILIO_*) — never tracked.
.env
backend/.env
frontend/.env

# Editors/OS
.DS_Store
*.swp

# Unrelated personal media accidentally living in the project root
Videos/
Images/

# Root-owned leftover from a rootless-Docker run (see docs/deviations.md Part 1); recreated by Django as logs/
backend/logs.docker-owned/

# Responsive-audit output (regenerate with `npm run audit:responsive`) — screenshots and
# measurements are evidence for one run, not source
frontend/tools/responsive-audit/out/
